    private async Task GuardarProducto()
    {
        if (string.IsNullOrWhiteSpace(ProductoEditando.Codigo))
        {
            MostrarFeedback("El código o SKU del producto es obligatorio.", false);
            return;
        }
        if (string.IsNullOrWhiteSpace(ProductoEditando.Nombre))
        {
            MostrarFeedback("El nombre del producto es obligatorio.", false);
            return;
        }
        if (ProductoEditando.IdCategoria <= 0)
        {
            MostrarFeedback("Debe seleccionar una categoría para el producto.", false);
            return;
        }
        if (ProductoEditando.EsGranel && (!ProductoEditando.PrecioGranel.HasValue || ProductoEditando.PrecioGranel.Value <= 0))
        {
            MostrarFeedback("Ha activado la venta a granel / caja. Debe ingresar el Precio Granel / Caja ($) para esta presentación.", false);
            return;
        }

        isSavingProducto = true;
        try
        {
            var res = await ProductService.SaveAsync(ProductoEditando);
            if (res.Success)
            {
                MostrarModalProducto = false;
                MostrarFeedback(res.Message, true);
                await CargarProductos();
            }
            else
            {
                MostrarFeedback(res.Message, false);
            }
        }
        finally
        {
            isSavingProducto = false;
        }
    }

    private async Task ToggleEstadoProducto(Producto p)
    {
        var res = await ProductService.ToggleEstadoAsync(p.IdProducto);
        MostrarFeedback(res.Message, res.Success);
        if (res.Success)
        {
            p.Estado = !p.Estado;
        }
    }

    private async Task SolicitarEliminarProducto(Producto p)
    {
        ProductoAEliminar = p;
        var check = await ProductService.PuedeEliminarProductoAsync(p.IdProducto);
        ProductoTieneVentas = !check.CanDelete;
        MostrarModalEliminar = true;
    }

    private async Task DesactivarEnLugarDeEliminar()
    {
        if (ProductoAEliminar != null)
        {
            MostrarModalEliminar = false;
            await ToggleEstadoProducto(ProductoAEliminar);
        }
    }

    private async Task EjecutarEliminacionFisica()
    {
        if (ProductoAEliminar == null) return;
        isDeletingProducto = true;
        try
        {
            var res = await ProductService.DeleteAsync(ProductoAEliminar.IdProducto);
            MostrarModalEliminar = false;
            MostrarFeedback(res.Message, res.Success);
            if (res.Success)
            {
                await CargarProductos();
            }
        }
        finally
        {
            isDeletingProducto = false;
        }
    }


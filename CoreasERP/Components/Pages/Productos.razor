    // AJUSTE DE STOCK BAJO SUPERVISIÓN
    // ==========================================
    private void AbrirModalAjusteStock(Producto p)
    {
        ProductoAjustando = p;
        NuevoStockAjuste = p.Stock;
        MotivoAjuste = "";
        SupervisorUsuario = AuthService.CurrentUser?.NombreUsuario ?? "";
        SupervisorClave = "";
        MostrarModalAjuste = true;
    }

    private async Task EjecutarAjusteStock()
    {
        if (ProductoAjustando == null) return;
        if (string.IsNullOrWhiteSpace(SupervisorUsuario) || string.IsNullOrWhiteSpace(SupervisorClave))
        {
            MostrarFeedback("Debe ingresar las credenciales de usuario y clave del Supervisor o Administrador.", false);
            return;
        }
        if (string.IsNullOrWhiteSpace(MotivoAjuste))
        {
            MostrarFeedback("Debe seleccionar o detallar el motivo del ajuste de inventario.", false);
            return;
        }

        isExecutingAjuste = true;
        try
        {
            var res = await ProductService.AjustarStockSupervisadoAsync(
                ProductoAjustando.IdProducto,
                NuevoStockAjuste,
                MotivoAjuste,
                SupervisorUsuario,
                SupervisorClave
            );

            if (res.Success)
            {
                MostrarModalAjuste = false;
                MostrarFeedback(res.Message, true);
                await CargarProductos();
            }
            else
            {
                MostrarFeedback(res.Message, false);
            }
        }
        finally
        {
            isExecutingAjuste = false;
        }
    }


    private async Task ExportarExcel()
    {
        isExporting = true;
        MensajeFeedback = null;
        try
        {
            var res = await ExcelExportService.ExportarInventarioCompletoAsync();
            FeedbackEsExito = res.Exitoso;
            MensajeFeedback = res.Mensaje;
            UltimaRutaDescargada = res.RutaArchivoLocal;

            if (res.Exitoso && res.ContenidoBytes.Length > 0)
            {
                await JS.InvokeVoidAsync("downloadFileFromBase64", res.NombreArchivo, res.Base64Data, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            }
        }
        catch (Exception ex)
        {
            MostrarFeedback($"Error al exportar inventario: {ex.Message}", false);
        }
        finally
        {
            isExporting = false;
        }
    }

    private void AbrirModalImportar()
    {
        MensajeModalImportar = null;
        ModalImportarEsError = false;
        RutaPlantillaDescargada = null;
        ErroresImportacion.Clear();
        inputFileKey++;
        MostrarModalImportar = true;
    }

    private void CerrarModalImportar()
    {
        if (isImporting) return;
        MostrarModalImportar = false;
        MensajeModalImportar = null;
        ModalImportarEsError = false;
        RutaPlantillaDescargada = null;
        ErroresImportacion.Clear();
        inputFileKey++;
    }

    private async Task DescargarPlantillaExcel()
    {
        try
        {
            var res = ExcelExportService.DescargarPlantillaImportacion();
            if (res.Exitoso)
            {
                RutaPlantillaDescargada = res.RutaArchivoLocal;
                MensajeModalImportar = "Plantilla generada con éxito y guardada en su carpeta de Descargas.";
                ModalImportarEsError = false;

                // También intentar descarga JS en entorno de navegador web si aplica
                if (!string.IsNullOrEmpty(res.Base64Data))
                {
                    try
                    {
                        await JS.InvokeVoidAsync("downloadFileFromBase64", "Plantilla_Inventario_CoreasERP.xlsx", res.Base64Data, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
                    }
                    catch
                    {
                        // Fallback ignorado en desktop nativo
                    }
                }
            }
            else
            {
                MensajeModalImportar = res.Mensaje;
                ModalImportarEsError = true;
            }
        }
        catch (Exception ex)
        {
            MensajeModalImportar = $"Error al descargar plantilla: {ex.Message}";
            ModalImportarEsError = true;
        }
    }

    private async Task ProcesarArchivoExcel(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isImporting = true;
        MensajeModalImportar = null;
        ErroresImportacion.Clear();
        StateHasChanged();

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            var res = await ExcelExportService.ImportarInventarioExcelAsync(ms);
            MensajeModalImportar = res.Mensaje;
            ModalImportarEsError = !res.Exitoso;
            ErroresImportacion = res.Errores ?? new List<string>();

            if (res.Exitoso)
            {
                MostrarFeedback(res.Mensaje, true);
                await CargarProductos();
                CategoriasParaCombo = await CategoryService.GetAllAsync();
            }
        }
        catch (Exception ex)
        {
            MensajeModalImportar = $"Error al procesar el archivo: {ex.Message}";
            ModalImportarEsError = true;
        }
        finally
        {
            isImporting = false;
            inputFileKey++; // Restablece el InputFile para permitir nuevas cargas sin reiniciar
            StateHasChanged();
        }
    }

    private void MostrarFeedback(string mensaje, bool exito)
    {
        MensajeFeedback = mensaje;
        FeedbackEsExito = exito;
    }

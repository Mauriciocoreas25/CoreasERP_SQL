<!-- MODAL 5: IMPORTAR INVENTARIO DESDE EXCEL O CSV                            -->
<!-- ========================================================================= -->
@if (MostrarModalImportar)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.55);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom py-3">
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="modal-title fw-bold mb-0">Importar Inventario (Excel / CSV)</h6>
                    </div>
                    <button type="button" class="btn-close" disabled="@isImporting" @onclick="CerrarModalImportar"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="alert alert-light border small mb-3">
                        Permite actualizar o crear productos en lote mediante un archivo de <strong>Excel (.xlsx)</strong> o <strong>delimitado (.csv)</strong>.<br />
                        Si el código o SKU ya existe, se actualizarán los precios y existencias; si no existe, se registrará como nuevo producto.
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <span class="small text-muted">¿Necesitas el formato de ejemplo?</span>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="DescargarPlantillaExcel" disabled="@isImporting">
                            <span>Descargar Plantilla (.xlsx)</span>
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(RutaPlantillaDescargada))
                    {
                        <div class="alert alert-success d-flex align-items-center justify-content-between p-2 small mb-3">
                            <div class="d-flex align-items-center gap-2 text-truncate me-2">
                                <span class="text-truncate">Plantilla guardada en <strong>Descargas</strong></span>
                            </div>
                            <div class="d-flex gap-1 flex-shrink-0">
                                <button type="button" class="btn btn-sm btn-success py-0 px-2" @onclick="() => ExcelExportService.AbrirArchivo(RutaPlantillaDescargada)">
                                    Abrir
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" @onclick="() => ExcelExportService.AbrirCarpeta(RutaPlantillaDescargada)">
                                    Carpeta
                                </button>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Seleccionar archivo Excel (.xlsx) o CSV (.csv)</label>
                        <InputFile @key="inputFileKey" OnChange="ProcesarArchivoExcel" class="form-control form-control-sm" accept=".xlsx,.csv,.txt" disabled="@isImporting" />
                    </div>

                    @if (!string.IsNullOrEmpty(MensajeModalImportar))
                    {
                        <div class="alert @(ModalImportarEsError ? "alert-danger" : "alert-success") small p-2 mb-3">
                            <div class="d-flex align-items-start gap-2">
                                <div style="white-space: pre-line;" class="w-100">
                                    @MensajeModalImportar
                                    @if (ErroresImportacion.Any())
                                    {
                                        <div class="mt-2 pt-2 border-top" style="max-height: 120px; overflow-y: auto;">
                                            <ul class="mb-0 ps-3 small text-muted">
                                                @foreach (var err in ErroresImportacion)
                                                {
                                                    <li>@err</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (isImporting)
                    {
                        <div class="text-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            <span class="ms-2 small text-muted">Procesando y validando registros en SQL Server...</span>
                        </div>
                    }
                </div>

                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-sm btn-secondary px-3" disabled="@isImporting" @onclick="CerrarModalImportar">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================= -->
<!-- MODAL 6: CONFIRMAR O IMPEDIR ELIMINACIÓN DE PRODUCTO                      -->
<!-- ========================================================================= -->
@if (MostrarModalEliminar)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.55);" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header border-bottom py-3 @(ProductoTieneVentas ? "bg-danger bg-opacity-10 text-danger" : "bg-light")">
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="modal-title fw-bold mb-0">
                            @(ProductoTieneVentas ? "Eliminación Restringida por Historial" : "Confirmar Eliminación")
                        </h6>
                    </div>
                    <button type="button" class="btn-close" @onclick="() => MostrarModalEliminar = false"></button>
                </div>

                <div class="modal-body p-4">
                    @if (ProductoTieneVentas)
                    {
                        <div class="alert alert-danger border-danger small mb-3">
                            <strong>No es posible eliminar este artículo:</strong>
                            <div class="mt-1">
                                El producto <strong>@ProductoAEliminar?.Nombre</strong> (SKU: @ProductoAEliminar?.Codigo) está vinculado a comprobantes y facturas emitidas anteriormente en el historial de ventas.
                            </div>
                            <div class="mt-2 text-muted">
                                Por integridad tributaria y contable, los artículos con ventas no deben borrarse. En su lugar, puede desactivarlo para que no aparezca en el punto de venta.
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-dark small mb-3">
                            ¿Está seguro de que desea eliminar permanentemente el producto:
                            <div class="p-2 border rounded bg-light mt-2">
                                <strong>@ProductoAEliminar?.Nombre</strong><br/>
                                <span class="text-muted font-monospace">Código: @ProductoAEliminar?.Codigo</span>
                            </div>
                        </div>
                        <div class="small text-danger">
                            Esta acción eliminará el producto del catálogo físico de SQL Server y no se podrá deshacer.
                        </div>
                    }
                </div>

                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => MostrarModalEliminar = false">
                        Cancelar
                    </button>
                    @if (ProductoTieneVentas)
                    {
                        <button type="button" class="btn btn-sm btn-warning text-white fw-semibold"
                                @onclick="DesactivarEnLugarDeEliminar">
                            Desactivar Artículo
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-sm btn-danger fw-semibold"
                                @onclick="EjecutarEliminacionFisica" disabled="@isDeletingProducto">
                            <span>@(isDeletingProducto ? "Eliminando..." : "Eliminar Definitivamente")</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string VistaActual = "productos"; // "productos" o "categorias"
    private List<Producto> ListaProductos = new();
    private List<Producto> ProductosFiltrados = new();
    private List<CategoriaDto> ListaCategorias = new();
    private List<CategoriaDto> CategoriasFiltradas = new();
    private List<Categoria> CategoriasParaCombo = new();

    private string TerminoBusqueda = "";
    private string TerminoBusquedaCategoria = "";
    private bool isLoadingProductos = true;
    private bool isLoadingCategorias = false;
    private bool isExporting = false;
    private bool isImporting = false;

    private string? MensajeFeedback = null;
    private bool FeedbackEsExito = true;
    private string? UltimaRutaDescargada = null;

    // Modales
    private bool MostrarModalProducto = false;
    private Producto ProductoEditando = new();
    private bool isSavingProducto = false;
    private bool isUploadingImagenProducto = false;
    private string? PreviewImagenProductoData = null;

    private bool MostrarModalAjuste = false;
    private Producto? ProductoAjustando;
    private decimal NuevoStockAjuste = 0m;
    private string MotivoAjuste = "";
    private string SupervisorUsuario = "";
    private string SupervisorClave = "";
    private bool isExecutingAjuste = false;

    private bool MostrarModalMateriales = false;
    private Producto? ProductoMaterialPadre;
    private List<ProductoMaterial> MaterialesActuales = new();
    private int IdInsumoSeleccionado = 0;
    private decimal CantidadMaterial = 1.00m;

    private bool MostrarModalCategoria = false;
    private Categoria CategoriaEditando = new();
    private bool isSavingCategoria = false;
    private bool isUploadingImagenCategoria = false;
    private string? PreviewImagenCategoriaData = null;

    private bool MostrarModalImportar = false;
    private int inputFileKey = 1;
    private string? MensajeModalImportar = null;
    private bool ModalImportarEsError = false;
    private string? RutaPlantillaDescargada = null;
    private List<string> ErroresImportacion = new();

    private bool MostrarModalEliminar = false;
    private Producto? ProductoAEliminar;
    private bool ProductoTieneVentas = false;
    private bool isDeletingProducto = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosIniciales();
    }

    private async Task CargarDatosIniciales()
    {
        isLoadingProductos = true;
        try
        {
            try
            {
                CategoriasParaCombo = await CategoryService.GetAllAsync() ?? new List<Categoria>();
            }
            catch (Exception exCat)
            {
                CategoriasParaCombo = new List<Categoria>();
                MensajeFeedback = $"Aviso: No se pudieron cargar categorías ({exCat.Message})";
                FeedbackEsExito = false;
            }

            await CargarProductos();
        }
        catch (Exception ex)
        {
            MensajeFeedback = $"Error al cargar catálogo de productos: {ex.Message}";
            FeedbackEsExito = false;
        }
        finally
        {
            isLoadingProductos = false;
        }
    }

    private async Task CargarProductos()
    {
        try
        {
            ListaProductos = await ProductService.GetAllAsync() ?? new List<Producto>();
            FiltrarProductos();
        }
        catch (Exception ex)
        {
            ListaProductos = new List<Producto>();
            ProductosFiltrados = new List<Producto>();
            MensajeFeedback = $"Error al consultar inventario desde la base de datos: {ex.Message}";
            FeedbackEsExito = false;
        }
    }

    private void FiltrarProductos()
    {
        if (ListaProductos == null)
        {
            ProductosFiltrados = new List<Producto>();
            return;
        }

        if (string.IsNullOrWhiteSpace(TerminoBusqueda))
        {
            ProductosFiltrados = ListaProductos.ToList();
        }
        else
        {
            string t = TerminoBusqueda.Trim().ToLower();
            ProductosFiltrados = ListaProductos
                .Where(p => (!string.IsNullOrEmpty(p.Nombre) && p.Nombre.ToLower().Contains(t)) 
                         || (!string.IsNullOrEmpty(p.Codigo) && p.Codigo.ToLower().Contains(t)) 
                         || (p.Categoria != null && !string.IsNullOrEmpty(p.Categoria.Nombre) && p.Categoria.Nombre.ToLower().Contains(t)))
                .ToList();
        }
    }

    private void LimpiarBusqueda()
    {
        TerminoBusqueda = "";
        FiltrarProductos();
    }

    private async Task CambiarVista(string vista)
    {
        VistaActual = vista;
        MensajeFeedback = null;
        if (VistaActual == "categorias")
        {
            await CargarCategorias();
        }
        else
        {
            await CargarProductos();
        }
    }

    private async Task CargarCategorias()
    {
        isLoadingCategorias = true;
        try
        {
            ListaCategorias = await CategoryService.GetAllWithCountAsync() ?? new List<CategoriaDto>();
            FiltrarCategorias();
        }
        catch (Exception ex)
        {
            ListaCategorias = new List<CategoriaDto>();
            CategoriasFiltradas = new List<CategoriaDto>();
            MensajeFeedback = $"Error al consultar categorías: {ex.Message}";
            FeedbackEsExito = false;
        }
        finally
        {
            isLoadingCategorias = false;
        }
    }

    private void FiltrarCategorias()
    {
        if (ListaCategorias == null)
        {
            CategoriasFiltradas = new List<CategoriaDto>();
            return;
        }

        if (string.IsNullOrWhiteSpace(TerminoBusquedaCategoria))
        {
            CategoriasFiltradas = ListaCategorias.ToList();
        }
        else
        {
            string t = TerminoBusquedaCategoria.Trim().ToLower();
            CategoriasFiltradas = ListaCategorias
                .Where(c => (!string.IsNullOrEmpty(c.Nombre) && c.Nombre.ToLower().Contains(t)) 
                         || (!string.IsNullOrEmpty(c.Descripcion) && c.Descripcion.ToLower().Contains(t)))
                .ToList();
        }
    }

    // ==========================================
    // ACCIONES DE PRODUCTOS
    // ==========================================
    private void AbrirModalNuevoProducto()
    {
        ProductoEditando = new Producto
        {
            Codigo = "",
            Nombre = "",
            IdCategoria = CategoriasParaCombo.FirstOrDefault()?.IdCategoria ?? 0,
            StockMinimo = 5,
            Stock = 0,
            PrecioCompra = 0.00m,
            PrecioVenta = 0.00m,
            PrecioGranel = null,
            CostoGranel = null,
            CantidadPorEmpaque = 1.00m,
            EsGranel = false,
            UnidadMedida = "Unidad",
            MargenExcepcion = 0.00m
        };
        PreviewImagenProductoData = null;
        MostrarModalProducto = true;
    }

    private void AbrirModalEditar(Producto p)
    {
        ProductoEditando = new Producto
        {
            IdProducto = p.IdProducto,
            IdCategoria = p.IdCategoria,
            Codigo = p.Codigo,
            Nombre = p.Nombre,
            Descripcion = p.Descripcion,
            PrecioCompra = p.PrecioCompra,
            PrecioVenta = p.PrecioVenta,
            PrecioGranel = p.PrecioGranel,
            CostoGranel = p.CostoGranel,
            CantidadPorEmpaque = p.CantidadPorEmpaque ?? 1.00m,
            EsGranel = p.EsGranel || (p.PrecioGranel.HasValue && p.PrecioGranel.Value > 0),
            UnidadMedida = string.IsNullOrWhiteSpace(p.UnidadMedida) ? "Unidad" : p.UnidadMedida,
            Stock = p.Stock,
            StockMinimo = p.StockMinimo,
            MargenExcepcion = p.MargenExcepcion,
            Imagen = p.Imagen,
            ImagenUrl = p.ImagenUrl,
            Estado = p.Estado
        };
        PreviewImagenProductoData = p.ImagenUrl;
        MostrarModalProducto = true;
    }

    private decimal CalcularMargenUnitario()
    {
        if (ProductoEditando == null || ProductoEditando.PrecioCompra <= 0) return 0m;
        return Math.Round(((ProductoEditando.PrecioVenta - ProductoEditando.PrecioCompra) / ProductoEditando.PrecioCompra) * 100m, 1);
    }

    private decimal ObtenerCostoGranelEfectivo()
    {
        if (ProductoEditando == null) return 0m;
        if (ProductoEditando.CostoGranel.HasValue && ProductoEditando.CostoGranel.Value > 0)
            return ProductoEditando.CostoGranel.Value;
        if (ProductoEditando.CantidadPorEmpaque.HasValue && ProductoEditando.CantidadPorEmpaque.Value > 0 && ProductoEditando.PrecioCompra > 0)
            return Math.Round(ProductoEditando.PrecioCompra / ProductoEditando.CantidadPorEmpaque.Value, 4);
        return ProductoEditando.PrecioCompra;
    }

    private decimal CalcularMargenGranel()
    {
        if (ProductoEditando == null || !ProductoEditando.PrecioGranel.HasValue || ProductoEditando.PrecioGranel.Value <= 0) return 0m;
        decimal costoG = ObtenerCostoGranelEfectivo();
        if (costoG <= 0) return 0m;
        return Math.Round(((ProductoEditando.PrecioGranel.Value - costoG) / costoG) * 100m, 1);
    }

    private decimal CalcularGananciaGranel()
    {
        if (ProductoEditando == null || !ProductoEditando.PrecioGranel.HasValue) return 0m;
        decimal costoG = ObtenerCostoGranelEfectivo();
        return ProductoEditando.PrecioGranel.Value - costoG;
    }

    private void OnPrecioCompraChanged()
    {
        if (ProductoEditando != null && ProductoEditando.PrecioCompra > 0 && ProductoEditando.CantidadPorEmpaque.HasValue && ProductoEditando.CantidadPorEmpaque.Value > 1)
        {
            ProductoEditando.CostoGranel = Math.Round(ProductoEditando.PrecioCompra / ProductoEditando.CantidadPorEmpaque.Value, 4);
            StateHasChanged();
        }
    }

    private void OnCantidadPorEmpaqueChanged()
    {
        if (ProductoEditando != null && ProductoEditando.PrecioCompra > 0 && ProductoEditando.CantidadPorEmpaque.HasValue && ProductoEditando.CantidadPorEmpaque.Value > 0)
        {
            ProductoEditando.CostoGranel = Math.Round(ProductoEditando.PrecioCompra / ProductoEditando.CantidadPorEmpaque.Value, 4);
            StateHasChanged();
        }
    }

    private void OnCostoGranelChanged()
    {
        if (ProductoEditando != null && ProductoEditando.PrecioCompra > 0 && ProductoEditando.CostoGranel.HasValue && ProductoEditando.CostoGranel.Value > 0)
        {
            decimal cantCalc = Math.Round(ProductoEditando.PrecioCompra / ProductoEditando.CostoGranel.Value, 2);
            if (cantCalc > 0 && (!ProductoEditando.CantidadPorEmpaque.HasValue || ProductoEditando.CantidadPorEmpaque.Value <= 1))
            {
                ProductoEditando.CantidadPorEmpaque = cantCalc;
            }
            StateHasChanged();
        }
    }


    private async Task AgregarMaterial()
    {
        if (ProductoMaterialPadre == null || IdInsumoSeleccionado <= 0 || CantidadMaterial <= 0) return;

        var res = await ProductService.AgregarMaterialAsync(ProductoMaterialPadre.IdProducto, IdInsumoSeleccionado, CantidadMaterial);
        if (res.Success)
        {
            MaterialesActuales = await ProductService.GetMaterialesAsync(ProductoMaterialPadre.IdProducto);
            IdInsumoSeleccionado = 0;
            CantidadMaterial = 1.00m;
        }
        else
        {
            MostrarFeedback(res.Message, false);
        }
    }

    private async Task EliminarMaterial(int idProductoMaterial)
    {
        if (ProductoMaterialPadre == null) return;
        var res = await ProductService.EliminarMaterialAsync(idProductoMaterial);
        if (res.Success)
        {
            MaterialesActuales = await ProductService.GetMaterialesAsync(ProductoMaterialPadre.IdProducto);
        }
        else
        {
            MostrarFeedback(res.Message, false);
        }
    }


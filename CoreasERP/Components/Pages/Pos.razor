    private async Task ConfirmarOperacionCaja()
    {
        if (MontoOperacionCaja <= 0)
        {
            MostrarAlerta("El monto debe ser mayor a cero.", esError: true);
            return;
        }
        if (string.IsNullOrWhiteSpace(MotivoOperacionCaja))
        {
            MostrarAlerta("Debe ingresar un motivo o justificación.", esError: true);
            return;
        }

        string motivoAudit = MotivoOperacionCaja.Trim();
        if (SupervisorQueAutorizo != null)
        {
            motivoAudit += $" (Autorizado por {SupervisorQueAutorizo.Nombre})";
        }

        int idUsuario = AuthService.CurrentUser?.IdUsuario ?? 1;
        var res = await CashRegisterService.RegistrarMovimientoCajaAsync(
            idUsuario, TipoOperacionCaja, MontoOperacionCaja, motivoAudit, CorteActivo?.IdCorte);

        if (res.Success && res.Movimiento != null)
        {
            var movGuardado = res.Movimiento;
            string nombreCajero = AuthService.CurrentUser?.Nombre ?? "Cajero";
            string? nombreSup = SupervisorQueAutorizo?.Nombre;

            UltimoMovimientoParaImprimir = movGuardado;
            CajeroUltimoMovimiento = nombreCajero;
            SupervisorUltimoMovimiento = nombreSup;

            if (ImprimirComprobanteOperacionCaja)
            {
                try
                {
                    configuracionNegocioPos ??= await SettingsService.GetConfiguracionAsync();
                    bool modoDirecto = configuracionNegocioPos?.ImpresionDirecta ?? true;

                    if (modoDirecto)
                    {
                        var printRes = await PrintService.PrintMovimientoCajaDirectAsync(movGuardado, nombreCajero, nombreSup, configuracionNegocioPos);
                        if (!printRes.Success)
                        {
                            // Fallback al diálogo JS si la impresora local directa falló
                            StateHasChanged();
                            await Task.Delay(150);
                            await PrintService.PrintMovimientoCajaAsync(JSRuntime, "movimiento-caja-receipt");
                        }
                    }
                    else
                    {
                        StateHasChanged();
                        await Task.Delay(150);
                        await PrintService.PrintMovimientoCajaAsync(JSRuntime, "movimiento-caja-receipt");
                    }
                }
                catch (Exception pEx)
                {
                    Console.WriteLine($"Aviso al imprimir comprobante de {TipoOperacionCaja}: {pEx.Message}");
                }
            }

            isCajaOperacionModalOpen = false;
            MostrarAlerta($"¡{res.Message} Comprobante emitido con éxito!", esError: false);
            await CargarTurnoCaja();
        }
        else if (res.Success)
        {
            isCajaOperacionModalOpen = false;
            MostrarAlerta(res.Message, esError: false);
            await CargarTurnoCaja();
        }
        else
        {
            MostrarAlerta(res.Message, esError: true);
        }
    }


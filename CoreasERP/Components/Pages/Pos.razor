    private async Task ConfirmarAperturaTurno()
    {
        if (MontoFondoInicialApertura < 0)
        {
            MostrarAlerta("El fondo inicial no puede ser negativo.", esError: true);
            return;
        }

        isOpeningTurno = true;
        StateHasChanged();
        try
        {
            int idUsuario = AuthService.CurrentUser?.IdUsuario ?? 1;
            var result = await CashRegisterService.AbrirCajaAsync(idUsuario, MontoFondoInicialApertura);
            if (result.Success)
            {
                await CargarTurnoCaja();
                isAperturaTurnoModalOpen = false;
                MensajeAperturaTurnoContexto = null;
                MostrarAlerta($"Turno de caja iniciado exitosamente con un fondo de ${MontoFondoInicialApertura:F2}.", esError: false);
                await EnfocarUpcAsync();
            }
            else
            {
                MostrarAlerta(result.Message, esError: true);
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta($"Error al abrir turno: {ex.Message}", esError: true);
        }
        finally
        {
            isOpeningTurno = false;
            StateHasChanged();
        }
    }


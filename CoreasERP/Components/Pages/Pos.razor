<!-- Modal de Devoluciones & Anulaciones (Ctrl+D) -->
@if (isDevolucionModalOpen)
{
    <div class="modal-backdrop-custom" tabindex="-1" style="z-index: 1080;" @onclick="() => isDevolucionModalOpen = false">
        <div class="modal-content-custom large" style="max-width: 780px;" @onclick:stopPropagation="true">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-dark text-white">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="mb-0 fw-bold text-white">Módulo de Devoluciones &amp; Anulaciones [Ctrl+D]</h6>
                </div>
                <button type="button" class="btn btn-sm text-white-50 p-0 border-0 bg-transparent fs-5 lh-1" 
                        @onclick="() => isDevolucionModalOpen = false">&times;</button>
            </div>
            <div class="p-3 bg-light border-bottom">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white text-muted">
                        <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                    </span>
                    <input type="text" class="form-control" placeholder="Buscar por número de comprobante o cliente..." 
                           @bind="BusquedaDevolucion" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(BusquedaDevolucion))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="() => BusquedaDevolucion = string.Empty">&times;</button>
                    }
                </div>
            </div>
            <div class="p-3 bg-white" style="max-height: 400px; overflow-y: auto;">
                @{
                    var ventasFiltradas = VentasRecientes.Where(v =>
                        string.IsNullOrWhiteSpace(BusquedaDevolucion) ||
                        (v.NumComprobante?.Contains(BusquedaDevolucion, StringComparison.OrdinalIgnoreCase) ?? false) ||
                        (v.Cliente?.Nombre?.Contains(BusquedaDevolucion, StringComparison.OrdinalIgnoreCase) ?? false)
                    ).ToList();
                }
                @if (!ventasFiltradas.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        No se encontraron ventas para devolución en la sesión actual.
                    </div>
                }
                else
                {
                    <table class="table table-sm table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th># Comprobante</th>
                                <th>Tipo</th>
                                <th>Cliente</th>
                                <th>Hora</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center" style="width: 140px;">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in ventasFiltradas)
                            {
                                <tr>
                                    <td class="font-monospace fw-bold">@v.NumComprobante</td>
                                    <td><span class="badge bg-secondary">@v.TipoComprobante</span></td>
                                    <td>@(v.Cliente?.Nombre ?? "Cliente General")</td>
                                    <td>@v.FechaHora.ToString("hh:mm tt")</td>
                                    <td class="text-end font-monospace fw-bold text-success">$@v.Total.ToString("F2")</td>
                                    <td class="text-center">
                                        <span class="badge @(v.Estado == "Completada" ? "bg-success" : "bg-danger")">
                                            @v.Estado
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (v.Estado == "Completada")
                                        {
                                            <button type="button" class="btn btn-sm btn-danger py-0 px-2 fw-semibold shadow-sm"
                                                    @onclick="() => AbrirDetalleParaDevolucion(v)">
                                                Anular / Devolver
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                                    @onclick="() => AbrirDetalleParaDevolucion(v)">
                                                Ver Detalle
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="p-3 border-top bg-light text-end">
                <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => isDevolucionModalOpen = false">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
}


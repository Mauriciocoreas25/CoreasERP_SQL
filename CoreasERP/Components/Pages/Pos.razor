    private async Task VerificarEstadoContingencia()
    {
        if (!isDteHabilitado) return;

        try
        {
            var resp = await FelSvApiService.ConsultarContingenciaActivaAsync();
            if (resp != null)
            {
                isContingencyActive = resp.Activa;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch
        {
            // FelSv API offline o no configurado aún
        }
    }

    private async Task OnContingencyStatusChanged(bool active)
    {
        if (isContingencyActive != active)
        {
            isContingencyActive = active;
            if (active)
            {
                MostrarAlerta("Modo Contingencia MH Activado: las ventas generarán DTE con estado 'Contingencia_Pendiente'.", esError: false);
            }
            else
            {
                MostrarAlerta("Modo Contingencia Finalizado: facturación electrónica normal en línea restablecida.", esError: false);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

@page "/pos"
@implements IDisposable
@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject ICustomerService CustomerService
@inject IPosService PosService
@inject ICashRegisterService CashRegisterService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IFelSvApiService FelSvApiService
@inject ISettingsService SettingsService
@inject IPrintService PrintService

<div class="pos-fullscreen-wrapper">
    <!-- 1. Cabecera de 9 Pestañas de Comprobantes (F1 a F9) -->
    <header class="pos-vouchers-bar">
        @for (int i = 0; i < Vouchers.Length; i++)
        {
            int idx = i;
            var v = Vouchers[idx];
            bool isActive = (SelectedComprobanteIndex == idx);

            <button type="button" 
                    class="pos-voucher-btn @(isActive ? "active" : "")"
                    @onclick="() => SeleccionarComprobante(idx)">
                <span class="pos-voucher-kkey">@v.Tecla</span>
                <span class="pos-voucher-label">@v.Nombre</span>
            </button>
        }
    </header>

    <!-- 2. Subcabecera: Selector de Cliente, Usuario y Botones de Salida -->
    <div class="pos-subheader-bar">
        <div class="d-flex align-items-center gap-2" style="max-width: 480px; width: 100%;">
            <label class="small fw-bold text-secondary mb-0 text-nowrap">Cliente:</label>
            <div class="input-group input-group-sm">
                <select class="form-select fw-semibold" @bind="SelectedClienteId" style="font-size: 13px;">
                    @foreach (var c in Clientes)
                    {
                        <option value="@c.IdCliente">
                            @c.Nombre @(!string.IsNullOrWhiteSpace(c.NumDocumento) ? $"({c.NumDocumento})" : "(Mostrador)")
                        </option>
                    }
                </select>
                <button class="btn btn-outline-secondary fw-bold" type="button" title="Nuevo Cliente Rápido" @onclick="() => isQuickCustomerOpen = true">
                    +
                </button>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            @if (isDteHabilitado)
            {
                @if (isContingencyActive)
                {
                    <button type="button" class="btn btn-sm btn-warning d-flex align-items-center gap-1 px-3 fw-bold shadow-sm"
                            @onclick="AbrirContingencia" title="Contingencia MH Activa (Clic para gestionar)">
                        <span class="spinner-grow spinner-grow-sm text-dark" style="width: 9px; height: 9px;"></span>
                        <span>Contingencia MH</span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-sm btn-outline-success d-flex align-items-center gap-1 px-3 fw-semibold shadow-sm"
                            @onclick="AbrirContingencia" title="Facturación Electrónica MH en Línea (Clic para contingencia)">
                        <span class="badge rounded-circle p-1 bg-success me-1" style="width: 8px; height: 8px; display: inline-block;"></span>
                        <span>DTE FelSv</span>
                    </button>
                }
            }
            else
            {
                <span class="badge bg-light text-secondary border px-2 py-1 fw-medium" title="Facturación Electrónica desactivada en Configuración. Las ventas se registran como comprobantes locales.">
                    Modo Local (Sin DTE)
                </span>
            }

            <div class="small fw-semibold text-secondary d-flex align-items-center gap-1">
                <span class="badge rounded-circle p-1 bg-success me-1" style="width: 8px; height: 8px; display: inline-block;"></span>
                <span>|</span>
                <span class="text-dark">@(AuthService.CurrentUser?.Nombre ?? "Usuario")</span>
            </div>

            @if (CorteActivo != null)
            {
                <span class="badge px-2.5 py-1 fw-bold d-none d-md-inline-flex align-items-center gap-1 shadow-sm" 
                      style="background-color: #dcfce7 !important; color: #14532d !important; border: 1.5px solid #86efac !important; font-size: 11.5px;" 
                      title="Turno de caja abierto">
                    <span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background-color: #16a34a;"></span>
                    <span>Turno #@CorteActivo.IdCorte</span>
                </span>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-warning text-dark fw-bold px-2 py-0 border shadow-sm d-flex align-items-center gap-1"
                        style="font-size: 11px;" @onclick="() => AbrirModalAperturaTurno()">
                    <span class="spinner-grow spinner-grow-sm text-dark" style="width: 7px; height: 7px;"></span>
                    <span>Abrir Turno</span>
                </button>
            }

            @if (!AuthService.IsCajero)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 px-3 fw-semibold shadow-sm"
                        @onclick="IrAlPanelErp" title="Volver al Panel Principal del ERP">
                    <span>Panel ERP</span>
                </button>
            }
            <button type="button" class="btn btn-sm btn-danger d-flex align-items-center gap-1 px-3 fw-semibold shadow-sm"
                    @onclick="CerrarSesion" title="Cerrar Sesión del Sistema">
                <span>Salir</span>
            </button>
        </div>
    </div>

    <!-- 3. Contenedor Principal: Tabla de Artículos + Barra Lateral de Acciones -->
    <div class="pos-body-grid">
        <!-- Panel Izquierdo: Tabla de Artículos y Fila de Captura Activa -->
        <div class="pos-table-container">
            @if (CorteActivo == null)
            {
                <div class="alert alert-warning mb-0 py-2 px-3 rounded-0 border-0 border-bottom d-flex justify-content-between align-items-center" style="font-size: 13px; background-color: #fffbeb;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-warning text-dark fw-bold">TURNO CERRADO</span>
                        <span class="text-dark">No hay un turno de caja abierto. Debe abrir turno con su fondo de caja inicial para realizar ventas y cortes.</span>
                    </div>
                    <button type="button" class="btn btn-sm btn-success fw-bold px-3 py-1 shadow-sm" style="font-size: 12px; background-color: #15803d; border-color: #15803d;" @onclick="() => AbrirModalAperturaTurno()">
                        + Abrir Turno de Caja
                    </button>
                </div>
            }
            @if (!string.IsNullOrEmpty(PosErrorMessage))
            {
                <div class="alert alert-danger mb-0 py-2 px-3 rounded-0 border-0 border-bottom d-flex justify-content-between align-items-center" style="font-size: 13px;">
                    <div class="d-flex align-items-center gap-2">
                        <strong>Error:</strong> @PosErrorMessage
                    </div>
                    <button type="button" class="btn-close btn-close-sm" @onclick="() => PosErrorMessage = null"></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(PosWarningMessage))
            {
                <div class="alert alert-warning mb-0 py-2 px-3 rounded-0 border-0 border-bottom d-flex justify-content-between align-items-center" style="font-size: 13px;">
                    <div class="d-flex align-items-center gap-2">
                        <strong>Atención:</strong> @PosWarningMessage
                    </div>
                    <button type="button" class="btn-close btn-close-sm" @onclick="() => PosWarningMessage = null"></button>
                </div>
            }
            <div class="pos-table-scroll">
                <table class="pos-table">
                    <thead>
                        <tr>
                            <th style="width: 190px;">Código de Barras</th>
                            <th>Descripción del Producto</th>
                            <th class="text-center" style="width: 120px;">Cantidad</th>
                            <th class="text-end" style="width: 140px;">Precio Unitario ($)</th>
                            <th class="text-end" style="width: 140px;">Total ($)</th>
                            <th class="text-center" style="width: 70px;">Quitar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Mensaje de Carrito Vacío -->
                        @if (!Carrito.Any() && ProductoEnEdicion == null)
                        {
                            <tr class="pos-row-empty">
                                <td colspan="6" class="py-5 text-center text-muted">
                                    <div class="fw-semibold mb-1">El carrito está vacío</div>
                                    <div>Presione la <strong class="text-success">Barra Espaciadora</strong> para buscar productos.</div>
                                </td>
                            </tr>
                        }

                        <!-- Listado de Artículos ya en el Carrito -->
                        @foreach (var item in Carrito)
                        {
                            <tr>
                                <td class="font-monospace text-secondary fw-semibold">
                                    @item.Codigo
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1">
                                        <div class="fw-bold text-dark text-truncate" style="max-width: 440px;" title="@item.Nombre">
                                            @item.Nombre
                                        </div>
                                        @if (item.EsGranel)
                                        {
                                            <span class="badge px-2 py-0.5 fw-bold shadow-sm" 
                                                  style="background-color: #dcfce7 !important; color: #14532d !important; border: 1px solid #86efac !important; font-size: 9.5px;">
                                                @(item.UnidadMedida == "Libra" ? "lb" : (item.UnidadMedida == "Kilogramo" ? "kg" : (item.UnidadMedida == "Gramo" ? "g" : (item.UnidadMedida == "Caja" ? "CAJA" : (item.UnidadMedida == "Sobre" ? "SOBRE" : "GRANEL")))))
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary border px-1" style="font-size: 9px;">
                                                UNIDAD
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="d-inline-flex align-items-center gap-1 border rounded px-1 bg-white">
                                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none text-muted" 
                                                style="font-size: 11px; width: 18px;" @onclick="() => ModificarCantidad(item, item.EsGranel ? -0.5m : -1m)">-</button>
                                        <span class="fw-bold px-2 font-monospace" style="font-size: 13px;">@item.Cantidad.ToString("G29")</span>
                                        <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none text-muted" 
                                                style="font-size: 11px; width: 18px;" @onclick="() => ModificarCantidad(item, item.EsGranel ? 0.5m : 1m)">+</button>
                                    </div>
                                </td>
                                <td class="text-end font-monospace text-secondary">
                                    $@item.Precio.ToString("F2")
                                </td>
                                <td class="text-end font-monospace fw-bold text-dark">
                                    $@item.Subtotal.ToString("F2")
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0 border-0 fs-6" 
                                            title="Quitar artículo" @onclick="() => EliminarDelCarrito(item)">
                                        &times;
                                    </button>
                                </td>
                            </tr>
                        }

                        <!-- Fila de Captura Activa (Requerimiento Central) -->
                        <tr class="pos-row-input">
                            @if (ProductoEnEdicion == null)
                            {
                                <!-- Estado A: Esperando escaneo, digitación o barra espaciadora -->
                                <td>
                                    <input @ref="inputUpcRef"
                                           type="text"
                                           class="form-control form-control-sm pos-upc-input trigger-spacebar-search font-monospace"
                                           placeholder="Escanear/Digitar UPC.."
                                           @bind="UpcInputValue"
                                           @bind:event="oninput"
                                           @onkeydown="HandleUpcKeyDown" />
                                </td>
                                <td colspan="5">
                                    <span class="text-muted small fst-italic ps-2" style="line-height: 31px;">
                                        Escriba o escanee el código de barras y presione Enter (o barra espaciadora para buscar)
                                    </span>
                                </td>
                            }
                            else
                            {
                                <!-- Estado B: Producto llamado con Celdas Bloqueadas y Foco en Cantidad Vacía -->
                                <td>
                                    <input type="text" 
                                           class="form-control form-control-sm bg-light font-monospace text-secondary" 
                                           value="@ProductoEnEdicion.Codigo" 
                                           readonly 
                                           disabled 
                                           style="cursor: not-allowed;" />
                                </td>
                                <td>
                                    <div>
                                        <input type="text" 
                                               class="form-control form-control-sm bg-light fw-bold text-dark text-truncate" 
                                               value="@ProductoEnEdicion.Nombre" 
                                               readonly 
                                               disabled 
                                               style="cursor: not-allowed;" />
                                    </div>
                                    @if (ProductoEnEdicion.PrecioGranel.HasValue && ProductoEnEdicion.PrecioGranel.Value > 0)
                                    {
                                        <div class="d-flex align-items-center gap-1 mt-1">
                                            <!-- Píldora Modo Unidad / Empaque -->
                                            <button type="button" 
                                                    class="btn btn-sm py-0 px-2 rounded-pill d-flex align-items-center gap-1 @(!EsModoGranelActivo ? "btn-primary fw-bold shadow-sm" : "btn-outline-secondary opacity-75")"
                                                    style="font-size: 10px;"
                                                    @onclick="() => SeleccionarModoPrecio(false)"
                                                    title="Vender a precio individual/unitario">
                                                <span>@(ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1 ? (ProductoEnEdicion.UnidadMedida == "Caja" ? "Caja" : "Empaque") : "Unitario"): $@ProductoEnEdicion.PrecioVenta.ToString("F2")</span>
                                                @if (!EsModoGranelActivo)
                                                {
                                                    <span class="badge bg-white text-primary px-1" style="font-size: 8px;">ACTIVO</span>
                                                }
                                            </button>

                                            <!-- Píldora Modo Granel / Menudeo -->
                                            <button type="button" 
                                                    class="btn btn-sm py-0 px-2 rounded-pill d-flex align-items-center gap-1 @(EsModoGranelActivo ? "btn-success fw-bold shadow-sm" : "btn-outline-secondary opacity-75")"
                                                    style="font-size: 10px;"
                                                    @onclick="() => SeleccionarModoPrecio(true)"
                                                    title="Presiona [ESPACIO] o clic para alternar a Menudeo/Granel">
                                                <span>@(ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1 ? "Granel / Sobre" : "Granel"): $@ProductoEnEdicion.PrecioGranel.Value.ToString("F2")</span>
                                                @if (EsModoGranelActivo)
                                                {
                                                    <span class="badge bg-white text-success px-1" style="font-size: 8px;">ACTIVO</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size: 9px;">[Espacio]</span>
                                                }
                                            </button>
                                        </div>
                                    }
                                    <div class="mt-1 d-flex align-items-center gap-2">
                                        <span class="badge fw-bold shadow-sm" 
                                              style="font-size: 10.5px; background-color: @(ProductoEnEdicion.Stock > 5 ? "#dcfce7" : "#fef9c3") !important; color: @(ProductoEnEdicion.Stock > 5 ? "#14532d" : "#854d0e") !important; border: 1px solid @(ProductoEnEdicion.Stock > 5 ? "#86efac" : "#fde047") !important;">
                                            Stock disponible: @ProductoEnEdicion.Stock.ToString("G29") @(ProductoEnEdicion.EsGranel ? ProductoEnEdicion.UnidadMedida : "uds")
                                            @if (ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1)
                                            {
                                                <span> (@((ProductoEnEdicion.Stock * ProductoEnEdicion.CantidadPorEmpaque.Value).ToString("G29")) sobres/piezas)</span>
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <!-- Celda de Cantidad con Foco Automático y VACÍA (Sin 1 por default) -->
                                    <input @ref="inputCantidadRef"
                                           type="number"
                                           step="@(EsModoGranelActivo || ProductoEnEdicion.EsGranel ? "any" : "1")"
                                           min="@(EsModoGranelActivo || ProductoEnEdicion.EsGranel ? "0.001" : "1")"
                                           max="@(EsModoGranelActivo && ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1 ? (ProductoEnEdicion.Stock * ProductoEnEdicion.CantidadPorEmpaque.Value) : ProductoEnEdicion.Stock)"
                                           class="form-control form-control-sm text-center fw-bold border-2 border-primary shadow-sm"
                                           placeholder=""
                                           @bind="CantidadEnEdicion"
                                           @onkeydown="HandleCantidadKeyDown" />
                                </td>
                                <td>
                                    <div class="position-relative">
                                        <input type="text" 
                                               class="form-control form-control-sm bg-light text-end font-monospace text-secondary fw-bold" 
                                               value="@($"${PrecioActualEdicion:F2}")" 
                                               readonly 
                                               disabled 
                                               style="cursor: not-allowed;" />
                                        @if (EsModoGranelActivo)
                                        {
                                            <span class="position-absolute top-0 start-0 translate-middle-y badge bg-success text-white" 
                                                  style="font-size: 8px; margin-left: 8px;">
                                                @(ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1 ? "Granel/Sobre" : (ProductoEnEdicion.UnidadMedida ?? "Granel"))
                                            </span>
                                        }
                                        else if (ProductoEnEdicion.PrecioGranel.HasValue && ProductoEnEdicion.PrecioGranel.Value > 0)
                                        {
                                            <span class="position-absolute top-0 start-0 translate-middle-y badge bg-primary text-white" 
                                                  style="font-size: 8px; margin-left: 8px;">
                                                Unidad
                                            </span>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-end text-primary font-monospace pe-2" style="line-height: 31px; font-size: 14px;">
                                        @($"${((CantidadEnEdicion ?? 0m) * PrecioActualEdicion):F2}")
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-danger p-0 px-2 fw-bold" 
                                            @onclick="CancelarProductoEnEdicion" 
                                            title="Cancelar selección (Esc)">
                                        &times;
                                    </button>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Panel Derecho: Barra Lateral Oscura de Acciones -->
        <aside class="pos-action-sidebar">
            <div>
                <!-- Acciones Operativas Superiores -->
                <button type="button" class="pos-sidebar-btn" @onclick="AbrirRetiro" title="Retiro de Efectivo de Caja [Ctrl+R]">
                    <span>Retiro Efectivo</span>
                    <span class="shortcut-badge">Ctrl+R</span>
                </button>
                <button type="button" class="pos-sidebar-btn" @onclick="AbrirDevolucion" title="Registro de Devoluciones [Ctrl+D o Alt+D]">
                    <span>Devoluciones</span>
                    <span class="shortcut-badge">Ctrl+D</span>
                </button>
                <button type="button" class="pos-sidebar-btn" @onclick="AbrirGasto" title="Registrar Gasto Menor de Caja [Ctrl+G]">
                    <span>Registrar Gasto</span>
                    <span class="shortcut-badge">Ctrl+G</span>
                </button>
                <button type="button" class="pos-sidebar-btn" @onclick="AbrirReimpresion" title="Reimpresión de Comprobantes [Ctrl+P]">
                    <span>Reimpresiones</span>
                    <span class="shortcut-badge">Ctrl+P</span>
                </button>
                <button type="button" class="pos-sidebar-btn" @onclick="AbrirModalGaveta" title="Abrir Gaveta de Dinero (Doble Autorización Cajero + Admin) [Ctrl+B]">
                    <span>Abrir Gaveta</span>
                    <span class="shortcut-badge">Ctrl+B</span>
                </button>
                <button type="button" class="pos-sidebar-btn @(isContingencyActive ? "amber" : "")" @onclick="AbrirContingencia" title="Gestión de Facturación Electrónica y Contingencia MH">
                    <span>Contingencia MH</span>
                    <span class="shortcut-badge">DTE</span>
                </button>
                <button type="button" class="pos-sidebar-btn red" @onclick="AbrirModalMerma" disabled="@(!Carrito.Any())" title="Dar de baja los productos cargados en el carrito como Merma / Gasto Interno">
                    <span>Salida / Merma</span>
                    <span class="shortcut-badge">Baja</span>
                </button>
            </div>

            <div>
                <!-- Acciones de Turno y Cierre Inferiores -->
                @if (CorteActivo != null)
                {
                    <div class="p-2 mb-2 rounded border bg-light text-center shadow-sm">
                        <div class="text-success fw-bold small">● Turno Activo #@CorteActivo.IdCorte</div>
                        <div class="text-muted" style="font-size: 11px;">Fondo Inicial: $@CorteActivo.MontoInicial.ToString("F2")</div>
                    </div>
                    <button type="button" class="pos-sidebar-btn green" @onclick="AbrirCorteX" title="Arqueo / Corte X Parcial [F11]">
                        <span>Corte X (Parcial)</span>
                        <span class="shortcut-badge">F11</span>
                    </button>
                    <button type="button" class="pos-sidebar-btn red" @onclick="AbrirCorteZ" title="Cierre Definitivo de Turno / Corte Z [F12]">
                        <span>Corte Z (Cierre)</span>
                        <span class="shortcut-badge">F12</span>
                    </button>
                }
                else
                {
                    <div class="p-2 mb-2 rounded border bg-warning bg-opacity-10 border-warning text-center shadow-sm">
                        <div class="text-warning-emphasis fw-bold small">○ Caja Cerrada</div>
                        <div class="text-muted" style="font-size: 11px;">Sin turno activo</div>
                    </div>
                    <button type="button" class="pos-sidebar-btn green fw-bold" @onclick="() => AbrirModalAperturaTurno()" title="Abrir Turno de Caja con Fondo Inicial">
                        <span>+ Abrir Turno</span>
                        <span class="shortcut-badge">Caja</span>
                    </button>
                    <button type="button" class="pos-sidebar-btn green opacity-75" @onclick="AbrirCorteX" title="Arqueo / Corte X Parcial [F11]">
                        <span>Corte X (Parcial)</span>
                        <span class="shortcut-badge">F11</span>
                    </button>
                    <button type="button" class="pos-sidebar-btn red opacity-75" @onclick="AbrirCorteZ" title="Cierre Definitivo de Turno / Corte Z [F12]">
                        <span>Corte Z (Cierre)</span>
                        <span class="shortcut-badge">F12</span>
                    </button>
                }
                <button type="button" class="pos-sidebar-btn dark-red" @onclick="CerrarSesion" title="Cerrar Sesión">
                    <span>Cerrar Sesión</span>
                    <span class="shortcut-badge">Salir</span>
                </button>
            </div>
        </aside>
    </div>

    <!-- 4. Barra Inferior de Atajos y Total de la Venta -->
    <footer class="pos-bottom-bar">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="pos-shortcut-helper">ESPACIO: Buscar Producto</span>
            <span class="pos-shortcut-helper">F1-F9: Tipo Comprobante</span>
            <span class="pos-shortcut-helper">F10: Cobrar y Emitir</span>
        </div>

        <div class="d-flex align-items-center gap-3">
            <button type="button" 
                    class="btn btn-outline-danger shadow-sm d-flex align-items-center gap-2 px-3 fw-bold rounded-3"
                    style="height: 48px; border-width: 2px;"
                    disabled="@(!Carrito.Any() || isProcessingPayment)"
                    @onclick="AbrirModalMerma"
                    title="Dar de baja los productos cargados en el carrito como Merma / Salida Interna a Costo">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="3 6 5 6 21 6"></polyline>
                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
                <span>Baja / Merma</span>
            </button>

            <div class="text-end">
                <div class="pos-total-tag">TOTAL DE LA VENTA</div>

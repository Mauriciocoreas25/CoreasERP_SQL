    private async Task NuevaVenta()
    {
        Carrito.Clear();
        SelectedClienteId = 1;
        ProductoEnEdicion = null;
        CantidadEnEdicion = null;
        UpcInputValue = "";
        isTicketOpen = false;
        isInvoiceLetterOpen = false;
        StateHasChanged();

        // Si la venta fue en efectivo, mostrar la pantalla de cambio durante 3 segundos mientras el cajero entrega el dinero
        if (UltimaVentaRegistrada != null && UltimaVentaRegistrada.MetodoPago == "Efectivo")
        {
            await MostrarPantallaCambioAsync(UltimaVentaRegistrada);
        }
        else
        {
            await EnfocarUpcAsync();
        }
    }


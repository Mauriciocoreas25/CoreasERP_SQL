<!-- Modal de Reimpresiones (Ctrl+P) -->
@if (isReimpresionModalOpen)
{
    <div class="modal-backdrop-custom" tabindex="-1" style="z-index: 1080;" @onclick="() => isReimpresionModalOpen = false">
        <div class="modal-content-custom large" style="max-width: 720px;" @onclick:stopPropagation="true">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center bg-dark text-white">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="mb-0 fw-bold text-white">Historial Rápido &amp; Reimpresión de Tickets</h6>
                </div>
                <button type="button" class="btn btn-sm text-white-50 p-0 border-0 bg-transparent fs-5 lh-1" 
                        @onclick="() => isReimpresionModalOpen = false">&times;</button>
            </div>
            <div class="p-3 bg-white" style="max-height: 400px; overflow-y: auto;">
                @if (!VentasRecientes.Any())
                {
                    <div class="text-center py-4 text-muted small">
                        No hay ventas registradas en la sesión actual.
                    </div>
                }
                else
                {
                    <table class="table table-sm table-hover align-middle small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th># Comprobante</th>
                                <th>Tipo</th>
                                <th>Cliente</th>
                                <th>Hora</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in VentasRecientes)
                            {
                                <tr>
                                    <td class="font-monospace fw-bold">@v.NumComprobante</td>
                                    <td><span class="badge bg-secondary">@v.TipoComprobante</span></td>
                                    <td>@(v.Cliente?.Nombre ?? "Cliente General")</td>
                                    <td>@v.FechaHora.ToString("hh:mm tt")</td>
                                    <td class="text-end font-monospace fw-bold text-success">$@v.Total.ToString("F2")</td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                                @onclick="() => ReimprimirVenta(v)">
                                            Imprimir
                                        </button>

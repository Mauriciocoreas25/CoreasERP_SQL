    private void ModificarCantidad(CartItemDto item, decimal cambio)
    {
        decimal nuevaCantidad = item.Cantidad + cambio;
        if (nuevaCantidad <= 0)
        {
            Carrito.Remove(item);
        }
        else
        {
            decimal factorItem = (item.EsGranel && item.CantidadPorEmpaque > 1) ? item.CantidadPorEmpaque : 1m;
            decimal nuevoBaseItem = nuevaCantidad / factorItem;

            decimal otroStockBaseEnCarrito = Carrito
                .Where(i => i.IdProducto == item.IdProducto && i != item)
                .Sum(i => i.CantidadBaseStock);

            decimal totalBaseRequerido = otroStockBaseEnCarrito + nuevoBaseItem;

            if (cambio > 0 && totalBaseRequerido > item.StockDisponible)
            {
                MostrarAlerta($"No hay más existencias disponibles para '{item.Nombre}' (Disponible: {item.StockDisponible:G29} unidades base).", esError: true);
                return;
            }
            item.Cantidad = nuevaCantidad;
        }
    }


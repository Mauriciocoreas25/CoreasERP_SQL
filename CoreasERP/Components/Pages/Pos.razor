    private async Task AbrirCobro()
    {
        if (!Carrito.Any()) return;
        await CargarTurnoCaja();
        if (CorteActivo == null)
        {
            AbrirModalAperturaTurno("Debe abrir un turno de caja indicando el fondo inicial antes de realizar cobros.");
            return;
        }
        isPaymentOpen = true;
    }

    private async Task ProcesarCobro((string Metodo, decimal PagoCon) cobro)
    {
        isProcessingPayment = true;
        try
        {
            int idUsuario = AuthService.CurrentUser?.IdUsuario ?? 1;

            var result = await PosService.RegistrarVentaAsync(
                SelectedClienteId,
                idUsuario,
                TipoComprobante,
                cobro.Metodo,
                cobro.PagoCon,
                Carrito.ToList());

            if (result.Success && result.Venta != null)
            {
                UltimaVentaRegistrada = result.Venta;
                isPaymentOpen = false;

                // Limpiar inmediatamente el carrito y la fila de captura al finalizar la venta
                Carrito.Clear();
                ProductoEnEdicion = null;
                CantidadEnEdicion = null;
                UpcInputValue = "";

                // Actualizar historial y turno
                await CargarCatalogos();
                await CargarTurnoCaja();

                // Abrir directamente la previsualización / impresión de comprobante (ticket o carta)
                bool esTicketRetail = TipoComprobante.Equals("Ticket", StringComparison.OrdinalIgnoreCase);
                if (esTicketRetail)
                {
                    isTicketOpen = true;
                }
                else
                {
                    isInvoiceLetterOpen = true;
                }
            }
            else
            {
                MostrarAlerta(result.Message, esError: true);
            }
        }
        catch (Exception ex)
        {
            MostrarAlerta($"Error inesperado al procesar cobro: {ex.Message}", esError: true);
        }
        finally
        {
            isProcessingPayment = false;
        }
    }

    private async Task MostrarPantallaCambioAsync(Venta venta)
    {
        isCambioModalOpen = true;
        cambioCountdownSeconds = 3;
        StateHasChanged();

        cambioCts?.Cancel();
        cambioCts = new CancellationTokenSource();
        var token = cambioCts.Token;

        try
        {
            for (int i = 3; i > 0; i--)
            {
                cambioCountdownSeconds = i;
                StateHasChanged();
                await Task.Delay(1000, token);
            }
        }
        catch (TaskCanceledException)
        {
            // Cancelado por interacción rápida del cajero (Enter/Espacio/Esc/Clic)
        }
        finally
        {
            await CerrarModalCambio();
        }
    }

    private async Task CerrarModalCambio()
    {
        if (!isCambioModalOpen) return;
        isCambioModalOpen = false;
        try
        {
            cambioCts?.Cancel();
            cambioCts = null;
        }
        catch { }
        StateHasChanged();
        await EnfocarUpcAsync();
    }

    private async Task HandleCambioKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" || e.Key == " " || e.Key == "Escape")
        {
            await CerrarModalCambio();
        }
    }


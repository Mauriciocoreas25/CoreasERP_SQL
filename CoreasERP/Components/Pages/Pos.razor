                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
            <div class="p-3 border-top bg-light text-end">
                <button type="button" class="btn btn-secondary btn-sm px-4" @onclick="() => isReimpresionModalOpen = false">
                    Cerrar
                </button>
            </div>
        </div>
    </div>

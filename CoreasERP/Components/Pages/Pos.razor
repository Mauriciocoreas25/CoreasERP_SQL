        _ = Task.Run(async () =>
        {
            await Task.Delay(4500);
            await InvokeAsync(() =>
            {
                if (esError) PosErrorMessage = null;
                else PosWarningMessage = null;
                StateHasChanged();
            });
        });
    }

    // Modales
    private PaymentDialog? paymentDialogRef;

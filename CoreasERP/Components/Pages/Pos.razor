    private List<CartItemDto> Carrito = new();
    private decimal TotalCarrito => FinancialRoundingHelper.Round2(Carrito.Sum(i => i.Subtotal));

    // Fila de Captura Activa
    private ElementReference inputUpcRef;
    private ElementReference inputCantidadRef;
    private string UpcInputValue = "";
    private Producto? ProductoEnEdicion = null;

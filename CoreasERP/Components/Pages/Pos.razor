    protected override async Task OnInitializedAsync()
    {
        // Suscripción a eventos de teclado globales y atajos
        KeyboardBridgeService.OnFunctionKeyPressed += HandleBridgeFunctionKey;
        KeyboardBridgeService.OnShortcutPressed += HandleBridgeShortcut;
        KeyboardBridgeService.OnSpacePressed += HandleBridgeSpace;
        KeyboardBridgeService.OnEnterPressed += HandleBridgeEnter;
        KeyboardBridgeService.OnBarcodeScanned += HandleBridgeBarcode;

        try
        {
            var config = await SettingsService.GetConfiguracionAsync();
            configuracionNegocioPos = config;
            isDteHabilitado = config?.HabilitarDte ?? true;
        }
        catch { }

        await CargarCatalogos();
        await CargarTurnoCaja();
        _ = VerificarEstadoContingencia();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await EnfocarUpcAsync();
        }

        if (isCambioModalOpen)
        {
            try
            {
                await Task.Delay(50);
                await btnCambioContinuarRef.FocusAsync();
            }
            catch { }
        }
    }

    public void Dispose()
    {
        try { cambioCts?.Cancel(); cambioCts?.Dispose(); } catch { }
        KeyboardBridgeService.OnFunctionKeyPressed -= HandleBridgeFunctionKey;
        KeyboardBridgeService.OnShortcutPressed -= HandleBridgeShortcut;
        KeyboardBridgeService.OnSpacePressed -= HandleBridgeSpace;
        KeyboardBridgeService.OnEnterPressed -= HandleBridgeEnter;
        KeyboardBridgeService.OnBarcodeScanned -= HandleBridgeBarcode;
    }

    private async Task CargarCatalogos()
    {
        Clientes = await CustomerService.GetAllAsync();
        if (Clientes.Any() && !Clientes.Any(c => c.IdCliente == SelectedClienteId))
        {
            SelectedClienteId = Clientes.First().IdCliente;
        }
        VentasRecientes = await PosService.GetVentasAsync(DateTime.Today);
    }

    private async Task CargarTurnoCaja()
    {
        int idUsuario = AuthService.CurrentUser?.IdUsuario ?? 1;
        CorteActivo = await CashRegisterService.GetCorteActivoAsync(idUsuario);
    }

    private void SeleccionarComprobante(int index)
    {
        if (index >= 0 && index < Vouchers.Length)
        {
            SelectedComprobanteIndex = index;
            StateHasChanged();
        }
    }

    // =========================================================================
    // ATAJOS GLOBALES
    // =========================================================================

    private void HandleBridgeFunctionKey(int fNum)
    {
        InvokeAsync(async () =>
        {
            if (isCambioModalOpen)
            {
                await CerrarModalCambio();
                return;
            }
            if (fNum >= 1 && fNum <= 9)
            {
                SeleccionarComprobante(fNum - 1);
            }
            else if (fNum == 10)
            {
                if (isTicketOpen && ticketPreviewDialogRef != null)
                {
                    await ticketPreviewDialogRef.Imprimir();
                }
                else if (isPaymentOpen && paymentDialogRef != null)
                {
                    await paymentDialogRef.Confirmar();
                }
                else
                {
                    await AbrirCobro();
                }
            }
            else if (fNum == 11)
            {
                await AbrirCorteX();
            }
            else if (fNum == 12)
            {
                await AbrirCorteZ();
            }
            StateHasChanged();
        });
    }

    private void HandleBridgeShortcut(string shortcut)
    {
        InvokeAsync(async () =>
        {
            switch (shortcut)
            {
                case "Ctrl+R":
                    await AbrirRetiro();
                    break;
                case "Ctrl+D":
                    await AbrirDevolucion();
                    break;
                case "Ctrl+G":
                    await AbrirGasto();
                    break;
                case "Ctrl+P":
                    await AbrirReimpresion();
                    break;
                case "Ctrl+B":
                    AbrirModalGaveta();
                    break;
            }
            StateHasChanged();
        });
    }

    private void HandleBridgeSpace()
    {
        InvokeAsync(async () =>
        {
            if (isCambioModalOpen)
            {
                await CerrarModalCambio();
                return;
            }
            if (!isProductSearchOpen && !isPaymentOpen && !isTicketOpen && ProductoEnEdicion == null)
            {
                isProductSearchOpen = true;
                StateHasChanged();
            }
        });
    }

    private void HandleBridgeEnter()
    {
        InvokeAsync(async () =>
        {
            if (isCambioModalOpen)
            {
                await CerrarModalCambio();
            }
        });
    }

    private void HandleBridgeBarcode(string barcode)
    {
        InvokeAsync(async () =>
        {
            if (!isPaymentOpen && !isTicketOpen && !isProductSearchOpen)
            {
                await BuscarPorCodigoBarrasAsync(barcode);
            }
        });
    }

    // =========================================================================
    // FLUJO DE CAPTURA ACTIVA: UPC -> FOCO EN CANTIDAD VACÍA -> ENTER -> CARRITO -> FOCO EN UPC
    // =========================================================================

    private async Task HandleUpcKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == " " || e.Key == "Spacebar")
        {
            TerminoBusquedaModal = "";
            isProductSearchOpen = true;
            UpcInputValue = "";
        }
        else if (e.Key == "Enter")
        {
            if (!string.IsNullOrWhiteSpace(UpcInputValue))
            {
                await BuscarPorCodigoBarrasAsync(UpcInputValue.Trim());
            }
            else
            {
                TerminoBusquedaModal = "";
                isProductSearchOpen = true;
            }
        }
    }

    private async Task BuscarPorCodigoBarrasAsync(string codigo)
    {
        var prod = await ProductService.GetByCodigoAsync(codigo);
        if (prod != null)
        {
            if (prod.Stock <= 0)
            {
                MostrarAlerta($"El producto '{prod.Nombre}' no cuenta con existencias disponibles (Stock: {prod.Stock:G29}). En el punto de venta no se permite vender sin stock.", esError: true);
                UpcInputValue = "";
                await EnfocarUpcAsync();
                return;
            }
            CargarProductoEnEdicion(prod);
        }
        else
        {
            // Abrir buscador con el término para que el usuario encuentre coincidencias
            TerminoBusquedaModal = codigo;
            isProductSearchOpen = true;
        }
    }

    private void OnProductSelectedFromSearchModal(Producto prod)
    {
        isProductSearchOpen = false;
        TerminoBusquedaModal = "";
        if (prod.Stock <= 0)
        {
            MostrarAlerta($"El producto '{prod.Nombre}' no cuenta con existencias disponibles (Stock: {prod.Stock:G29}). En el punto de venta no se permite vender sin stock.", esError: true);
            UpcInputValue = "";
            _ = EnfocarUpcAsync();
            return;
        }
        CargarProductoEnEdicion(prod);
    }

    private void CargarProductoEnEdicion(Producto prod)
    {
        if (prod.Stock <= 0)
        {
            MostrarAlerta($"El producto '{prod.Nombre}' no cuenta con existencias disponibles (Stock: {prod.Stock:G29}). En el punto de venta no se permite vender sin stock.", esError: true);
            UpcInputValue = "";
            _ = EnfocarUpcAsync();
            return;
        }

        ProductoEnEdicion = prod;
        bool tienePrecioGranel = prod.PrecioGranel.HasValue && prod.PrecioGranel.Value > 0;
        EsModoGranelActivo = prod.EsGranel && tienePrecioGranel;
        PrecioActualEdicion = (EsModoGranelActivo && tienePrecioGranel)
            ? prod.PrecioGranel!.Value
            : prod.PrecioVenta;
        UpcInputValue = "";
        CantidadEnEdicion = null; // Requerimiento: VACÍA (Sin 1 por default)
        StateHasChanged();

        // Enviar foco automáticamente a la celda de Cantidad
        _ = Task.Run(async () =>
        {
            await Task.Delay(50);
            await InvokeAsync(async () =>
            {
                try
                {
                    await inputCantidadRef.FocusAsync();
                }
                catch { }
            });
        });
    }

    private async Task HandleCantidadKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ConfirmarAgregarAlCarritoAsync();
        }
        else if (e.Key == "Escape")
        {
            await CancelarProductoEnEdicion();
        }
        else if (e.Key == " " || e.Key == "Spacebar" || e.Code == "Space")
        {
            ToggleModoGranel();
        }
    }

    private void ToggleModoGranel()
    {
        if (ProductoEnEdicion == null) return;

        bool tienePrecioGranel = ProductoEnEdicion.PrecioGranel.HasValue && ProductoEnEdicion.PrecioGranel.Value > 0;
        if (!tienePrecioGranel)
        {
            MostrarAlerta($"El producto '{ProductoEnEdicion.Nombre}' solo cuenta con Precio Unitario (${ProductoEnEdicion.PrecioVenta:F2}). No tiene configurado un precio a granel o caja.", esError: false);
            EsModoGranelActivo = false;
            PrecioActualEdicion = ProductoEnEdicion.PrecioVenta;
            StateHasChanged();
            _ = Task.Run(async () =>
            {
                await Task.Delay(30);
                await InvokeAsync(async () => { try { await inputCantidadRef.FocusAsync(); } catch { } });
            });
            return;
        }

        EsModoGranelActivo = !EsModoGranelActivo;
        if (EsModoGranelActivo)
        {
            PrecioActualEdicion = ProductoEnEdicion.PrecioGranel!.Value;
            string etiqueta = (ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1)
                ? "GRANEL / SOBRE"
                : (!string.IsNullOrWhiteSpace(ProductoEnEdicion.UnidadMedida) ? ProductoEnEdicion.UnidadMedida.ToUpper() : "GRANEL");
            MostrarAlerta($"Modo {etiqueta} activo: ${PrecioActualEdicion:F2}.", esError: false);
        }
        else
        {
            PrecioActualEdicion = ProductoEnEdicion.PrecioVenta;
            string etiqueta = (ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1)
                ? (ProductoEnEdicion.UnidadMedida == "Caja" ? "CAJA" : "EMPAQUE / UNIDAD")
                : "UNIDAD";
            MostrarAlerta($"Modo {etiqueta} activo: ${PrecioActualEdicion:F2}.", esError: false);
        }
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(30);
            await InvokeAsync(async () =>
            {
                try
                {
                    await inputCantidadRef.FocusAsync();
                }
                catch { }
            });
        });
    }

    private void SeleccionarModoPrecio(bool aGranel)
    {
        if (ProductoEnEdicion == null) return;
        if (aGranel)
        {
            bool tienePrecioGranel = ProductoEnEdicion.PrecioGranel.HasValue && ProductoEnEdicion.PrecioGranel.Value > 0;
            if (!tienePrecioGranel)
            {
                MostrarAlerta($"El producto '{ProductoEnEdicion.Nombre}' no tiene configurado un precio a granel o caja.", esError: true);
                return;
            }
            EsModoGranelActivo = true;
            PrecioActualEdicion = ProductoEnEdicion.PrecioGranel!.Value;
            string etiqueta = (ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1)
                ? "GRANEL / SOBRE"
                : (!string.IsNullOrWhiteSpace(ProductoEnEdicion.UnidadMedida) ? ProductoEnEdicion.UnidadMedida.ToUpper() : "GRANEL");
            MostrarAlerta($"Modo {etiqueta} seleccionado: ${PrecioActualEdicion:F2}.", esError: false);
        }
        else
        {
            EsModoGranelActivo = false;
            PrecioActualEdicion = ProductoEnEdicion.PrecioVenta;
            string etiqueta = (ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1)
                ? (ProductoEnEdicion.UnidadMedida == "Caja" ? "CAJA" : "EMPAQUE / UNIDAD")
                : "UNIDAD";
            MostrarAlerta($"Modo {etiqueta} seleccionado: ${PrecioActualEdicion:F2}.", esError: false);
        }
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            await Task.Delay(30);
            await InvokeAsync(async () =>
            {
                try
                {
                    await inputCantidadRef.FocusAsync();
                }
                catch { }
            });
        });
    }

    private async Task ConfirmarAgregarAlCarritoAsync()
    {
        if (ProductoEnEdicion == null) return;

        if (ProductoEnEdicion.Stock <= 0)
        {
            MostrarAlerta($"El producto '{ProductoEnEdicion.Nombre}' está agotado (Stock: 0).", esError: true);
            await CancelarProductoEnEdicion();
            return;
        }

        decimal cant = CantidadEnEdicion ?? 0m;
        if (cant <= 0)
        {
            // No permitir agregar con 0 o vacío
            return;
        }

        // Si el producto no es a granel y el modo granel no está activo, verificar si intentaron poner decimales
        if (!ProductoEnEdicion.EsGranel && !EsModoGranelActivo && cant % 1m != 0m)
        {
            MostrarAlerta($"El producto '{ProductoEnEdicion.Nombre}' solo se vende por unidades enteras.", esError: true);
            return;
        }

        // Buscamos si ya existe con la misma modalidad (EsGranel) y precio
        var existente = Carrito.FirstOrDefault(i => i.IdProducto == ProductoEnEdicion.IdProducto && i.EsGranel == EsModoGranelActivo);

        decimal factorConversion = (EsModoGranelActivo && ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1)
            ? ProductoEnEdicion.CantidadPorEmpaque.Value
            : 1m;

        decimal cantBaseSolicitada = cant / factorConversion;

        // Calcular el stock base ocupado por este producto en el carrito
        decimal stockBaseEnCarrito = Carrito
            .Where(i => i.IdProducto == ProductoEnEdicion.IdProducto)
            .Sum(i => i.CantidadBaseStock);

        decimal nuevoStockBaseTotal = stockBaseEnCarrito + cantBaseSolicitada;

        if (nuevoStockBaseTotal > ProductoEnEdicion.Stock)
        {
            string unidad = ProductoEnEdicion.UnidadMedida ?? "uds";
            if (EsModoGranelActivo && factorConversion > 1)
            {
                decimal sobresMaximos = Math.Max(0m, (ProductoEnEdicion.Stock - stockBaseEnCarrito) * factorConversion);
                MostrarAlerta($"Existencias insuficientes para '{ProductoEnEdicion.Nombre}'. Disponibles en granel: {sobresMaximos:G29} sobres/piezas ({ProductoEnEdicion.Stock:G29} {unidad}). Ya en carrito equivalente: {stockBaseEnCarrito:G29} {unidad}. Solicitado: {cant:G29} sobres.", esError: true);
            }
            else
            {
                MostrarAlerta($"Existencias insuficientes para '{ProductoEnEdicion.Nombre}'. Stock disponible: {ProductoEnEdicion.Stock:G29} {unidad}. Ya en carrito: {stockBaseEnCarrito:G29} {unidad}. Solicitado: {cant:G29} {unidad}.", esError: true);
            }
            return;
        }

        string descPresentacion = EsModoGranelActivo 
            ? (ProductoEnEdicion.CantidadPorEmpaque.HasValue && ProductoEnEdicion.CantidadPorEmpaque.Value > 1 ? "Sobre" : "Granel")
            : (!string.IsNullOrWhiteSpace(ProductoEnEdicion.UnidadMedida) ? ProductoEnEdicion.UnidadMedida : "Unidad");

        decimal costoItem = EsModoGranelActivo 
            ? ProductoEnEdicion.CostoEfectivoGranel 
            : (ProductoEnEdicion.PrecioCompra > 0 ? ProductoEnEdicion.PrecioCompra : 0m);

        // Agregar al carrito
        if (existente != null)
        {
            existente.Cantidad += cant;
            existente.Precio = PrecioActualEdicion > 0 ? PrecioActualEdicion : ProductoEnEdicion.PrecioVenta;
            existente.CostoUnitario = costoItem;
        }
        else
        {
            Carrito.Add(new CartItemDto
            {
                IdProducto = ProductoEnEdicion.IdProducto,
                Codigo = ProductoEnEdicion.Codigo,
                Nombre = ProductoEnEdicion.Nombre,
                Precio = PrecioActualEdicion > 0 ? PrecioActualEdicion : ProductoEnEdicion.PrecioVenta,
                CostoUnitario = costoItem,
                Cantidad = cant,
                StockDisponible = ProductoEnEdicion.Stock,
                EsGranel = EsModoGranelActivo,
                CantidadPorEmpaque = ProductoEnEdicion.CantidadPorEmpaque ?? 1.00m,
                UnidadMedida = descPresentacion
            });
        }

        // Limpiar fila de edición y devolver foco a celda UPC
        ProductoEnEdicion = null;
        CantidadEnEdicion = null;
        EsModoGranelActivo = false;
        PrecioActualEdicion = 0m;
        UpcInputValue = "";
        StateHasChanged();

        await EnfocarUpcAsync();
    }

    private async Task CancelarProductoEnEdicion()
    {
        ProductoEnEdicion = null;
        CantidadEnEdicion = null;
        EsModoGranelActivo = false;
        PrecioActualEdicion = 0m;
        UpcInputValue = "";
        StateHasChanged();


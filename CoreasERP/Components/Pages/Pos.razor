<!-- Modal de Animación y Confirmación de Cambio a Devolver (3 segundos después de imprimir ticket) -->
@if (isCambioModalOpen && UltimaVentaRegistrada != null)
{
    <div class="modal-backdrop-custom d-flex align-items-center justify-content-center" 
         tabindex="0" 
         style="z-index: 1200; background-color: rgba(15, 23, 42, 0.75);" 
         @onkeydown="HandleCambioKeyDown" 
         @onclick="CerrarModalCambio">
        <div class="modal-content-custom shadow-lg text-center" 
             style="max-width: 480px; width: 92%; border-radius: 16px; overflow: hidden; border: 3px solid #16a34a; background-color: #ffffff; animation: cambioPop 0.25s ease-out;" 
             @onclick:stopPropagation="true">
            
            <!-- Encabezado de Éxito -->
            <div class="p-4" style="background: linear-gradient(135deg, #15803d 0%, #166534 100%); color: white;">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-2" 
                     style="width: 60px; height: 60px; background-color: rgba(255, 255, 255, 0.2); border: 2.5px solid #86efac;">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                </div>
                <h4 class="fw-bold mb-0 text-white">¡Cobro y Emisión Finalizados!</h4>
                <div class="small text-white-50 mt-1">Ticket / Comprobante: @UltimaVentaRegistrada.NumComprobante (@UltimaVentaRegistrada.TipoComprobante)</div>
            </div>

            <!-- Cuerpo con CAMBIO A DEVOLVER PROMINENTE -->
            <div class="p-4">
                @if (UltimaVentaRegistrada.MetodoPago == "Efectivo")
                {
                    @if ((UltimaVentaRegistrada.Cambio ?? 0m) > 0m)
                    {
                        <div class="p-3 rounded-3 mb-3 shadow-sm" style="background-color: #dcfce7 !important; border: 2.5px solid #22c55e !important;">
                            <div class="text-uppercase fw-bold" style="color: #14532d; font-size: 13px; letter-spacing: 1px;">
                                CAMBIO A ENTREGAR AL CLIENTE
                            </div>
                            <div class="font-monospace fw-bolder my-1" style="font-size: 3.4rem; color: #14532d !important; line-height: 1.1;">
                                $@(UltimaVentaRegistrada.Cambio?.ToString("F2") ?? "0.00")
                            </div>
                            <div class="fw-semibold" style="font-size: 13px; color: #166534;">
                                Cliente pagó con: $@(UltimaVentaRegistrada.PagoCon?.ToString("F2") ?? "0.00") &bull; Total: $@UltimaVentaRegistrada.Total.ToString("F2")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-3 mb-3 shadow-sm" style="background-color: #f0fdf4 !important; border: 2.5px solid #16a34a !important;">
                            <div class="text-uppercase fw-bold" style="color: #14532d; font-size: 13px; letter-spacing: 1px;">
                                PAGO EXACTO EN EFECTIVO
                            </div>
                            <div class="font-monospace fw-bolder my-1" style="font-size: 3rem; color: #14532d !important; line-height: 1.1;">
                                CAMBIO: $0.00
                            </div>
                            <div class="fw-semibold" style="font-size: 13px; color: #166534;">
                                Total recibido: $@UltimaVentaRegistrada.Total.ToString("F2") (Sin vuelto)
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="p-3 rounded-3 mb-3 shadow-sm" style="background-color: #f0fdf4 !important; border: 2px solid #86efac !important;">
                        <div class="text-uppercase fw-bold" style="color: #14532d; font-size: 13px;">
                            PAGO REGISTRADO (@UltimaVentaRegistrada.MetodoPago.ToUpper())
                        </div>
                        <div class="font-monospace fw-bolder my-1" style="font-size: 2.8rem; color: #15803d;">
                            $@UltimaVentaRegistrada.Total.ToString("F2")
                        </div>
                        <div class="text-muted small">Transacción autorizada y cobrada exitosamente</div>
                    </div>
                }

                <!-- Barra de cuenta regresiva de 3 segundos -->
                <div class="mb-3">
                    <div class="progress" style="height: 6px; background-color: #e2e8f0; border-radius: 3px; overflow: hidden;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" 
                             style="width: 100%; background-color: #16a34a; animation: shrinkWidth 3s linear forwards;">
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 text-muted" style="font-size: 11.5px;">
                        <span>Listo para nueva venta en <strong>@cambioCountdownSeconds s</strong>...</span>
                        <span>Presione <strong>Enter</strong> para continuar ya</span>
                    </div>
                </div>

                <!-- Botón de acción para el cajero con foco automático y enter -->
                <button @ref="btnCambioContinuarRef"
                        type="button" 
                        class="btn btn-success w-100 py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2"
                        style="background-color: #15803d; border-color: #15803d; font-size: 15px;"
                        @onclick="CerrarModalCambio">
                    <span>Listo / Nueva Venta</span>
                    <span class="badge bg-dark bg-opacity-25 text-white" style="font-size: 11px;">[Enter]</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- Visualizador y Emisión de Ticket Térmico -->
<TicketPreviewDialog @ref="ticketPreviewDialogRef" @bind-IsOpen="isTicketOpen" Venta="@UltimaVentaRegistrada" OnVerCarta="AbrirDocumentoCarta" OnNuevaVenta="NuevaVenta" />

<!-- Visualizador y Emisión de Documento en Formato Carta (CCF, Factura, Notas, etc.) -->

@if (UltimoMovimientoParaImprimir != null)
{
    <!-- Plantilla Térmica de Movimiento de Caja (Retiro / Gasto) para Fallback JS / Navegador -->
    <div id="movimiento-caja-receipt" style="display: none;">
        <div class="ticket-header" style="text-align: center; margin-bottom: 6px; border-bottom: 1px dashed #000; padding-bottom: 4px;">
            <div class="ticket-title" style="font-size: 13px; font-weight: bold;">@(configuracionNegocioPos?.NombreNegocio ?? "COREAS ERP")</div>

<!-- Modal de Apertura de Turno de Caja -->
@if (isAperturaTurnoModalOpen)
{
    <div class="modal-backdrop-custom" tabindex="-1" style="z-index: 1090;" @onclick="() => isAperturaTurnoModalOpen = false">
        <div class="modal-content-custom" style="max-width: 500px;" @onclick:stopPropagation="true">
            <div class="p-3 border-bottom d-flex justify-content-between align-items-center text-white"
                 style="background: linear-gradient(135deg, #14532d 0%, #166534 100%);">
                <div class="d-flex align-items-center gap-2">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                        <circle cx="12" cy="12" r="2"></circle>
                        <path d="M6 12h.01M18 12h.01"></path>
                    </svg>
                    <div>
                        <h6 class="mb-0 fw-bold text-white">Apertura de Turno de Caja</h6>
                        <small class="text-white-50" style="font-size: 11px;">Control de efectivo y ventas del turno</small>
                    </div>
                </div>
                <button type="button" class="btn btn-sm text-white-50 p-0 border-0 bg-transparent fs-5 lh-1" 
                        @onclick="() => isAperturaTurnoModalOpen = false">&times;</button>
            </div>

            <div class="p-4 bg-white">
                @if (!string.IsNullOrEmpty(MensajeAperturaTurnoContexto))
                {
                    <div class="alert alert-warning py-2 px-3 small mb-3 border-0 bg-warning bg-opacity-10 text-dark">
                        <span class="fw-bold">Nota:</span> @MensajeAperturaTurnoContexto
                    </div>
                }

                <div class="card bg-light border p-3 rounded-3 mb-3 small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Cajero:</span>
                        <span class="fw-bold text-dark">@(AuthService.CurrentUser?.Nombre ?? "Cajero")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted">Fecha y Hora:</span>
                        <span class="fw-semibold text-secondary">@DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Estación:</span>
                        <span class="badge bg-secondary">Caja Principal (POS)</span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-dark">Fondo Inicial de Caja (Cambio en Gaveta):</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-light fw-bold text-secondary">$</span>
                        <input type="number" step="0.01" min="0" class="form-control fw-bold fs-4 text-success" 
                               @bind="MontoFondoInicialApertura" placeholder="50.00" autofocus />
                    </div>
                    <div class="form-text small text-muted">
                        Ingresa el monto de dinero físico con el que se inicia la gaveta para dar cambio.
                    </div>
                </div>

                <!-- Botones rápidos de fondo -->
                <div class="d-flex gap-2 mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => MontoFondoInicialApertura = 0m">$0.00</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => MontoFondoInicialApertura = 20m">$20.00</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => MontoFondoInicialApertura = 50m">$50.00</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-fill" @onclick="() => MontoFondoInicialApertura = 100m">$100.00</button>
                </div>
            </div>

            <div class="p-3 border-top bg-light d-flex justify-content-end gap-2">
                <button type="button" class="btn btn-secondary btn-sm px-3" @onclick="() => isAperturaTurnoModalOpen = false" disabled="@isOpeningTurno">
                    Cancelar
                </button>
                <button type="button" class="btn btn-success btn-sm px-4 fw-bold shadow-sm" style="background-color: #15803d; border-color: #15803d;" 
                        @onclick="ConfirmarAperturaTurno" disabled="@isOpeningTurno">
                    @if (isOpeningTurno)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Abriendo turno...</span>
                    }
                    else
                    {
                        <span>✓ Iniciar Turno y Abrir Caja</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Modal de Arqueo Físico y Desglose de Efectivo (Billetes y Monedas para Corte X y Corte Z) -->
<ArqueoEfectivoModal @bind-IsOpen="isArqueoModalOpen" 

        <div style="text-align: center; font-size: 10px; border-top: 1px dashed #000; padding-top: 4px; margin-top: 15px;">
            <div>Comprobante de control interno de caja.</div>
            <div>Conserve este ticket para arqueo de turno.</div>
        </div>
    </div>
}

@code {
    // Definición de Comprobantes según captura (F1 a F9)

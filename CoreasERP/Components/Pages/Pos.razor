        new("F3", "CCF (03)"),
        new("F4", "N.Remisión (04)"),
        new("F5", "N.Crédito (05)"),
        new("F6", "N.Débito (06)"),
        new("F7", "Suj.Excluido (14)"),
        new("F8", "Anticipo"),
        new("F9", "Cotización")
    };

    private int SelectedComprobanteIndex = 0;
